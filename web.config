<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS configuration for the Lab Staff Quality Feedback Form (Python / Flask app).

  IIS does not run app.py itself. This file tells IIS to start Python (through
  Microsoft's HttpPlatformHandler module) and pass every request to the app.

  BEFORE USING: if the site folder is NOT E:\labfeedback, change the
  two paths marked "CHANGE IF NEEDED" below.
-->
<configuration>
  <system.webServer>

    <handlers>
      <!-- Send every request to Python. IIS serves nothing from this folder directly. -->
      <add name="PythonHandler" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified" />
    </handlers>

    <!-- CHANGE IF NEEDED: processPath and stdoutLogFile -->
    <httpPlatform processPath="E:\labfeedback\venv\Scripts\python.exe"
                  arguments="-m waitress --host=127.0.0.1 --port=%HTTP_PLATFORM_PORT% --threads=8 --trusted-proxy=* --trusted-proxy-headers=&quot;x-forwarded-for x-forwarded-proto&quot; app:app"
                  stdoutLogEnabled="true"
                  stdoutLogFile="E:\labfeedback\logs\python.log"
                  startupTimeLimit="60"
                  startupRetryCount="3"
                  requestTimeout="00:02:00">
      <environmentVariables>
        <!-- 1 = site is served over HTTPS (recommended). Set to 0 only for a plain-http test. -->
        <environmentVariable name="LAB_HTTPS" value="1" />
        <environmentVariable name="PYTHONUNBUFFERED" value="1" />
      </environmentVariables>
    </httpPlatform>

    <security>
      <requestFiltering>
        <!-- Allow Excel uploads up to 10 MB (matches the app's own limit) -->
        <requestLimits maxAllowedContentLength="10485760" />
        <!-- Never let anyone download the database, secret key, logs or Python environment -->
        <hiddenSegments>
          <add segment="instance" />
          <add segment="venv" />
          <add segment="logs" />
          <add segment="__pycache__" />
          <add segment="data received" />
        </hiddenSegments>
      </requestFiltering>
    </security>

    <!-- Show the app's own error pages instead of IIS error pages -->
    <httpErrors existingResponse="PassThrough" />

  </system.webServer>
</configuration>
